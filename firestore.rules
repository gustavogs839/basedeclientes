rules_version = '2';

// Regras abertas: qualquer pessoa com o link do site pode ler e escrever
// na base de clientes (sem login). Se depois quiser restringir, troque
// "if true" por uma checagem de autenticação (request.auth != null).
service cloud.firestore {
  match /databases/{database}/documents {
    match /clientes/{clienteId} {
      allow read, write: if true;
    }
  }
}
